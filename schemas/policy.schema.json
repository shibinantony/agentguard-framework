{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PolicyDefinition",
  "description": "Schema for AgentGuard policy and release gates",
  "type": "object",
  "required": ["policy_id", "version", "name", "rules"],
  "properties": {
    "policy_id": { "type": "string" },
    "version": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "rules": {
      "type": "object",
      "properties": {
        "max_prompt_injections": { "type": "integer", "minimum": 0, "default": 0 },
        "max_secret_leaks": { "type": "integer", "minimum": 0, "default": 0 },
        "max_unauthorized_tools": { "type": "integer", "minimum": 0, "default": 0 },
        "max_irreversible_actions_without_approval": { "type": "integer", "minimum": 0, "default": 0 },
        "min_quality_score": { "type": "number", "minimum": 1.0, "maximum": 5.0, "default": 3.5 },
        "min_judge_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.7 },
        "max_latency_ms": { "type": "number", "minimum": 0.0, "default": 5000.0 },
        "max_cost_per_task_usd": { "type": "number", "minimum": 0.0, "default": 0.10 }
      },
      "additionalProperties": true
    },
    "actions": {
      "type": "object",
      "properties": {
        "on_safety_breach": { "type": "string", "enum": ["BLOCK", "REVIEW"], "default": "BLOCK" },
        "on_quality_failure": { "type": "string", "enum": ["BLOCK", "REVIEW"], "default": "BLOCK" },
        "on_budget_breach": { "type": "string", "enum": ["BLOCK", "REVIEW"], "default": "REVIEW" }
      }
    }
  },
  "additionalProperties": false
}
